# Copy to .env. Docker's env_file does not strip inline comments, so keep comments on their own lines.
# frontend sends X-API-Key
API_KEY=change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DATA_DIR=/data
SANDBOX_URL=http://sandbox:9000
OLLAMA_URL=http://ollama:11434
# or a Falcon-H1-Arabic GGUF if you have it working
OLLAMA_MODEL=qwen3:4b
LLM_ENABLED=true
# AI analyst: claude (Anthropic API, reads screenshots too; page content is sent to Anthropic),
# ollama (local model, nothing leaves the server; start with --profile llm), or off
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
VISUAL_ENABLED=true
# true only for demo-sites / authorised targets
AGENT_ENABLED=false
# agent never runs on other hosts
AGENT_ALLOWED_SUFFIXES=.test
SERPAPI_KEY=
GOOGLE_PLACES_KEY=
DISCOVERY_INTERVAL_MIN=20
DISCOVERY_ENABLED=true
# true = serve cached results first
DEMO_MODE=false
SCAN_CONCURRENCY=3
# URL the browser uses to reach the backend
PUBLIC_API_URL=http://localhost:8000
# Server deployment (deploy/deploy.sh): public HTTPS name for Caddy; defaults to <server-ip>.sslip.io
DOMAIN=
