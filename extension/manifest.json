{
  "manifest_version": 3,
  "name": "ScamShield Link Scanner",
  "version": "0.1.0",
  "description": "Automatically scans links on any page for scam/fraud risk and warns before you open a dangerous one.",
  "permissions": ["storage", "activeTab", "notifications"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
